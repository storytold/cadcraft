{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    [
      "@semantic-release/exec",
      {
        "analyzeCommitsCmd": "printf 'patch\\n'",
        "prepareCmd": "cargo xtask version set ${nextRelease.version}",
        "publishCmd": "git push origin HEAD:release && gh workflow run release.yml --ref release --field version=${nextRelease.version}"
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/git",
      {
        "assets": ["Cargo.toml", "Cargo.lock"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "draftRelease": true,
        "releaseNameTemplate": "CadCraft v<%= nextRelease.version %>",
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}

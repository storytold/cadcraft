+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_a_set_and_its_blocks() {
+        let s = parse(
+            r#"{"name":"P&ID","groups":[{"name":"Valves","tools":[
+                {"label":"Gate","input":"(pid:tool \"VLV_GATE\")","block":["PIP_VLV_GATE","ISA_VLV_GATE"]},
+                {"input":"PIDINST","block":"PIP_INST_FIELD"},
+                {"label":"nothing to run"}]}]}"#,
+        )
+        .unwrap();
+        assert_eq!(s.name, "P&ID");
+        assert_eq!(s.groups.len(), 1);
+        let tools = &s.groups[0].tools;
+        assert_eq!(tools.len(), 2, "a tool without input is dropped");
+        assert_eq!(tools[0].blocks, ["PIP_VLV_GATE", "ISA_VLV_GATE"]);
+        assert_eq!(tools[1].label, "PIDINST", "a tool without a label is labelled by its input");
+        assert_eq!(tools[1].blocks, ["PIP_INST_FIELD"]);
+    }
+
+    #[test]
+    fn refuses_sets_without_name_or_tools_and_never_panics() {
+        assert!(parse("{}").is_err());
+        assert!(parse(r#"{"name":"X","groups":[]}"#).is_err());
+        assert!(parse(r#"{"name":"X","groups":[{"name":"G","tools":[]}]}"#).is_err());
+        for hostile in ["", "[", "null", "1e999", r#"{"name":1}"#, r#"{"name":"X","groups":{"a":1}}"#, "\u{0}"] {
+            let _ = parse(hostile);
+        }
+    }
+
+    #[test]
+    fn caps_sizes() {
+        let tools: Vec<String> =
+            (0..500).map(|_| format!(r#"{{"label":"{}","input":"LINE","block":[{}]}}"#, "L".repeat(500), r#""B","#.repeat(40) + r#""B""#)).collect();
+        let text = format!(r#"{{"name":"{}","groups":[{{"name":"G","tools":[{}]}}]}}"#, "N".repeat(500), tools.join(","));
+        let s = parse(&text).unwrap();
+        assert_eq!(s.name.chars().count(), MAX_NAME);
+        assert_eq!(s.groups[0].tools.len(), MAX_TOOLS);
+        assert_eq!(s.groups[0].tools[0].label.chars().count(), MAX_NAME);
+        assert_eq!(s.groups[0].tools[0].blocks.len(), MAX_BLOCKS);
+    }
+
+    #[cfg(not(target_arch = "wasm32"))]
+    #[test]
+    fn loads_json_files_in_order_and_refuses_built_in_or_repeated_names() {
+        let dir = std::env::temp_dir().join(format!("cc-toolsets-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let set = |n: &str| format!(r#"{{"name":"{n}","groups":[{{"name":"G","tools":[{{"input":"LINE"}}]}}]}}"#);
+        std::fs::write(dir.join("b.json"), set("Second")).unwrap();
+        std::fs::write(dir.join("a.json"), set("First")).unwrap();
+        std::fs::write(dir.join("c.json"), set("drafting")).unwrap();
+        std::fs::write(dir.join("d.json"), set("first")).unwrap();
+        std::fs::write(dir.join("e.json"), "not json").unwrap();
+        std::fs::write(dir.join("f.txt"), set("Ignored")).unwrap();
+        let (sets, errors) = load_dir(&dir);
+        let names: Vec<&str> = sets.iter().map(|s| s.name.as_str()).collect();
+        assert_eq!(names, ["First", "Second"]);
+        assert_eq!(errors.len(), 3, "{errors:?}");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn a_tool_submits_its_lines_as_typed_and_cancels_a_running_command() {
+        let mut app = CadApp::new(cadcraft_engine::Session::new(), crate::Services::default());
+        app.cmdline("line");
+        assert!(app.session.prompting());
+        run_tool(&mut app, "circle 0,0 5\ncircle 10,0 2");
+        let st = app.session.state().unwrap();
+        let circles = st.doc.model.iter().filter(|e| matches!(e.kind, EntityKind::Circle(_))).count();
+        assert_eq!(circles, 2);
+        assert!(!app.session.prompting());
+    }
+
+    #[test]
+    fn a_missing_folder_reads_nothing() {
+        let mut store = Store::default();
+        store.ensure(Some(Path::new("/nonexistent/cadcraft-support")));
+        assert!(store.sets.is_empty() && store.errors.is_empty());
+        store.ensure(None);
+        assert!(store.sets.is_empty());
+    }
+}

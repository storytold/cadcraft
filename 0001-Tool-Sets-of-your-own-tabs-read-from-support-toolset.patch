+/// One tool button: the block drawn fitted into the tile, or its label.
+fn tool_button(ui: &mut egui::Ui, list: Option<&DisplayList>, tool: &Tool, id: egui::Id) -> egui::Response {
+    let t = Tokens::get();
+    let (rect, _) = ui.allocate_exact_size(vec2(TILE, TILE), Sense::hover());
+    let resp = ui.interact(rect, id, Sense::click());
+    let p = ui.painter_at(rect);
+    let fill = if resp.hovered() { t.control } else { t.panel };
+    p.rect_filled(rect.shrink(1.0), 4.0, fill);
+    if resp.hovered() {
+        p.rect_stroke(rect.shrink(1.0), 4.0, Stroke::new(1.0, t.border), egui::StrokeKind::Inside);
+    }
+    match list {
+        Some(l) => {
+            let b = l.bounds;
+            let inner = rect.shrink(8.0);
+            let (w, h) = (b.width().max(1e-9), b.height().max(1e-9));
+            let scale = (f64::from(inner.width()) / w).min(f64::from(inner.height()) / h);
+            let xf = Xf { rect, center: Vec2::new((b.min.x + b.max.x) / 2.0, (b.min.y + b.max.y) / 2.0), scale, twist: 0.0 };
+            crate::canvas::draw_list(&p, &xf, l, Rgb(fill.r(), fill.g(), fill.b()), false);
+        }
+        None => {
+            let short: String = tool.label.chars().take(10).collect();
+            p.text(rect.center(), egui::Align2::CENTER_CENTER, short, egui::FontId::proportional(9.5), t.text);
+        }
+    }
+    crate::icons::describe_control(ui, &resp, &tool.label, None, false);
+    resp.on_hover_text(&tool.label)
+}
+
+/// The body of a user tab: its groups, collapsible like the built-in ones, tools in rows.
+/// Returns the input of the tool clicked.
+pub fn body(app: &mut CadApp, ui: &mut egui::Ui, set_name: &str) -> Option<String> {
+    let t = Tokens::get();
+    let set = app.user_toolsets.get(set_name)?.clone();
+    let mut clicked = None;
+    let mut toggle = None;
+    for (gi, g) in set.groups.iter().enumerate() {
+        let key = format!("{set_name}/{}", g.name);
+        let collapsed = app.ui.collapsed_groups.contains(&key);
+        let (hr, hresp) = ui.allocate_exact_size(vec2(ui.available_width(), 22.0), Sense::click());
+        let pp = ui.painter();
+        crate::icons::paint(
+            pp,
+            Rect::from_center_size(pos2(hr.left() + 11.0, hr.center().y), vec2(11.0, 11.0)),
+            if collapsed { crate::icons::Icon::ChevronRight } else { crate::icons::Icon::ChevronDown },
+            false,
+        );
+        pp.text(pos2(hr.left() + 22.0, hr.center().y), egui::Align2::LEFT_CENTER, &g.name, egui::FontId::proportional(12.5), t.text);
+        crate::icons::describe_control(ui, &hresp, &g.name, Some(!collapsed), false);
+        if hresp.clicked() {
+            toggle = Some(key);
+        }
+        if !collapsed {
+            ui.add_space(2.0);
+            let per_row = (((ui.available_width() - 12.0) / (TILE + 2.0)).floor() as usize).max(1);
+            for (ri, row) in g.tools.chunks(per_row).enumerate() {
+                ui.horizontal(|ui| {
+                    ui.add_space(8.0);
+                    ui.spacing_mut().item_spacing = vec2(2.0, 0.0);
+                    for (ti, tool) in row.iter().enumerate() {
+                        let list = icon(app, tool);
+                        let id = ui.scope_id().with(("user_tool", set_name, gi, ri, ti));
+                        if tool_button(ui, list.as_deref(), tool, id).clicked() {
+                            clicked = Some(tool.input.clone());
+                        }
+                    }
+                });
+                ui.add_space(2.0);
+            }
+            ui.add_space(4.0);
+        }
+        let (sr, _) = ui.allocate_exact_size(vec2(ui.available_width(), 1.0), Sense::hover());
+        ui.painter().hline(sr.x_range().shrink(6.0), sr.center().y, Stroke::new(1.0, t.border));
+    }
+    if let Some(k) = toggle {
+        if let Some(i) = app.ui.collapsed_groups.iter().position(|x| *x == k) {
+            app.ui.collapsed_groups.remove(i);
+        } else {
+            app.ui.collapsed_groups.push(k);
+        }
+    }
+    clicked
+}

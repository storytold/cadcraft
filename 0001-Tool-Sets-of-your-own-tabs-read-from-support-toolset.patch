+++ b/crates/ui-egui/src/user_toolsets.rs
@@ -0,0 +1,460 @@
+//! Tool Sets of your own: extra Tool Sets tabs read from `.json` files in the `toolsets` folder of
+//! the support folder (`<settings>/support/toolsets`, next to `acad.lsp`). Each tool is a button
+//! that submits command-line text, as if typed: a command, a LISP command (`PIDVALV`) or a LISP
+//! expression (`(my:tool "GATE")`). A tool can show a block of the current drawing as its icon,
+//! drawn from the block definition, so a symbol library needs no image files.
+//!
+//! ```json
+//! { "name": "P&ID",
+//!   "groups": [ { "name": "Valves",
+//!                 "tools": [ { "label": "Gate valve", "input": "(pid:tool \"VLV_GATE\")",
+//!                              "block": ["PIP_VLV_GATE", "ISA_VLV_GATE"] } ] } ] }
+//! ```
+//!
+//! `block` is a block name or a list of them; the first one the drawing defines is drawn. A tool
+//! without one (or whose blocks the drawing lacks) shows its label. Files are read when the Tool
+//! Sets first show and again with `ui.toolsets.reload`. Every size is capped: the files are user
+//! input. Nothing here touches the file system on the web.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use cadcraft_color::Rgb;
+use cadcraft_doc::EntityKind;
+use cadcraft_geom::Vec2;
+use cadcraft_render::DisplayList;
+use egui::{Rect, Sense, Stroke, pos2, vec2};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+use crate::CadApp;
+use crate::canvas::Xf;
+use crate::theme::Tokens;
+
+/// The folder, under the support folder, the tool set files are read from.
+pub const FOLDER: &str = "toolsets";
+/// Most tool set files read.
+const MAX_FILES: usize = 16;
+/// Largest tool set file read (bytes).
+const MAX_FILE_BYTES: u64 = 256 * 1024;
+/// Most groups in a tool set, and tools in a group.
+const MAX_GROUPS: usize = 32;
+const MAX_TOOLS: usize = 128;
+/// Longest name, label and command-line input kept (characters).
+const MAX_NAME: usize = 40;
+const MAX_INPUT: usize = 1024;
+/// Most block names a tool lists.
+const MAX_BLOCKS: usize = 8;
+/// Most lines one tool submits.
+const MAX_LINES: usize = 16;
+/// Side of a tool button (points), and how many fit a row.
+const TILE: f32 = 46.0;
+
+/// One user tab of the Tool Sets.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ToolSet {
+    pub name: String,
+    pub groups: Vec<Group>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Group {
+    pub name: String,
+    pub tools: Vec<Tool>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Tool {
+    pub label: String,
+    /// Command-line text submitted when the tool is clicked; lines are submitted one by one.
+    pub input: String,
+    /// Blocks to draw as the icon; the first one the drawing defines is used.
+    pub blocks: Vec<String>,
+}
+
+/// The tool sets read, where from, and the block icons built for the current drawing.
+#[derive(Default)]
+pub struct Store {
+    pub sets: Vec<ToolSet>,
+    /// Problems found reading the files (shown once on the command line).
+    pub errors: Vec<String>,
+    /// The folder the sets were read from (`None`: not read yet).
+    loaded_from: Option<Option<PathBuf>>,
+    /// Block icons by (drawing uid, revision, block name).
+    icons: HashMap<(u64, u64, String), Option<Arc<DisplayList>>>,
+}
+
+// ---------------------------------------------------------------- file format
+
+#[derive(Deserialize)]
+struct FileSet {
+    #[serde(default)]
+    name: String,
+    #[serde(default)]
+    groups: Vec<FileGroup>,
+}
+
+#[derive(Deserialize)]
+struct FileGroup {
+    #[serde(default)]
+    name: String,
+    #[serde(default)]
+    tools: Vec<FileTool>,
+}
+
+#[derive(Deserialize)]
+struct FileTool {
+    #[serde(default)]
+    label: String,
+    #[serde(default)]
+    input: String,
+    #[serde(default)]
+    block: Option<Value>,
+}
+
+fn clip(s: &str, n: usize) -> String {
+    s.trim().chars().filter(|c| !c.is_control() || *c == '\n').take(n).collect()
+}
+
+/// Parse one tool set file. Unknown fields are ignored; sizes are capped; a set without a name
+/// or without tools is refused.
+pub fn parse(text: &str) -> Result<ToolSet, String> {
+    let f: FileSet = serde_json::from_str(text).map_err(|e| format!("not a tool set: {e}"))?;
+    let name = clip(&f.name, MAX_NAME).replace('\n', " ");
+    if name.is_empty() {
+        return Err("the tool set has no \"name\"".into());
+    }
+    let mut groups = Vec::new();
+    for g in f.groups.into_iter().take(MAX_GROUPS) {
+        let tools: Vec<Tool> = g
+            .tools
+            .into_iter()
+            .take(MAX_TOOLS)
+            .filter_map(|t| {
+                let input = clip(&t.input, MAX_INPUT);
+                if input.is_empty() {
+                    return None;
+                }
+                let blocks = match t.block {
+                    Some(Value::String(s)) => vec![s],
+                    Some(Value::Array(a)) => a.into_iter().filter_map(|v| v.as_str().map(str::to_string)).collect(),
+                    _ => Vec::new(),
+                };
+                let blocks = blocks.iter().map(|b| clip(b, 255).replace('\n', "")).filter(|b| !b.is_empty()).take(MAX_BLOCKS).collect();
+                let label = clip(&t.label, MAX_NAME).replace('\n', " ");
+                Some(Tool { label: if label.is_empty() { input.lines().next().unwrap_or_default().to_string() } else { label }, input, blocks })
+            })
+            .collect();
+        if !tools.is_empty() {
+            groups.push(Group { name: clip(&g.name, MAX_NAME).replace('\n', " "), tools });
+        }
+    }
+    if groups.is_empty() {
+        return Err(format!("the tool set \"{name}\" has no tools"));
+    }
+    Ok(ToolSet { name, groups })
+}
+
+/// Read the `.json` files of `dir`, in name order. Built-in tab names and repeated names are
+/// refused.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn load_dir(dir: &Path) -> (Vec<ToolSet>, Vec<String>) {
+    let mut sets: Vec<ToolSet> = Vec::new();
+    let mut errors = Vec::new();
+    let Ok(rd) = std::fs::read_dir(dir) else { return (sets, errors) };
+    let mut files: Vec<PathBuf> = rd
+        .filter_map(|e| e.ok().map(|e| e.path()))
+        .filter(|p| p.extension().is_some_and(|x| x.eq_ignore_ascii_case("json")) && p.is_file())
+        .collect();
+    files.sort();
+    if files.len() > MAX_FILES {
+        errors.push(format!("Tool Sets: only the first {MAX_FILES} files of {} are read", dir.display()));
+        files.truncate(MAX_FILES);
+    }
+    for p in files {
+        let shown = p.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+        let text = match std::fs::metadata(&p) {
+            Ok(m) if m.len() > MAX_FILE_BYTES => {
+                errors.push(format!("Tool Sets: {shown} is larger than {} KB", MAX_FILE_BYTES / 1024));
+                continue;
+            }
+            Ok(_) => match std::fs::read(&p) {
+                Ok(b) => String::from_utf8_lossy(&b).into_owned(),
+                Err(e) => {
+                    errors.push(format!("Tool Sets: {shown}: {e}"));
+                    continue;
+                }
+            },
+            Err(e) => {
+                errors.push(format!("Tool Sets: {shown}: {e}"));
+                continue;
+            }
+        };
+        match parse(&text) {
+            Ok(s) if BUILT_IN.iter().any(|b| b.eq_ignore_ascii_case(&s.name)) || sets.iter().any(|o| o.name.eq_ignore_ascii_case(&s.name)) => {
+                errors.push(format!("Tool Sets: {shown}: the name \"{}\" is already used", s.name));
+            }
+            Ok(s) => sets.push(s),
+            Err(e) => errors.push(format!("Tool Sets: {shown}: {e}")),
+        }
+    }
+    (sets, errors)
+}
+
+#[cfg(target_arch = "wasm32")]
+pub fn load_dir(_dir: &Path) -> (Vec<ToolSet>, Vec<String>) {
+    (Vec::new(), Vec::new())
+}
+
+/// The built-in tabs, which user sets may not replace.
+pub const BUILT_IN: [&str; 2] = ["Drafting", "Modeling"];
+
+impl Store {
+    /// Read the sets from `support/toolsets` unless they were read from there already.
+    pub fn ensure(&mut self, support: Option<&Path>) {
+        let dir = support.map(|s| s.join(FOLDER));
+        if self.loaded_from.as_ref() == Some(&dir) {
+            return;
+        }
+        let (sets, errors) = dir.as_deref().map(load_dir).unwrap_or_default();
+        self.sets = sets;
+        self.errors = errors;
+        self.loaded_from = Some(dir);
+        self.icons.clear();
+    }
+
+    /// Forget what was read, so the next frame reads the files again.
+    pub fn reload(&mut self) {
+        self.loaded_from = None;
+    }
+
+    pub fn get(&self, name: &str) -> Option<&ToolSet> {
+        self.sets.iter().find(|s| s.name == name)
+    }
+}
+
+/// `ui.toolsets.reload`: read the tool set files again → `{toolsets: [names], errors}`.
+pub fn reload(app: &mut CadApp) -> Result<Value, String> {
+    app.user_toolsets.reload();
+    let support = app.session.lisp_support_dir().map(Path::to_path_buf);
+    app.user_toolsets.ensure(support.as_deref());
+    report_errors(app);
+    let names: Vec<&str> = app.user_toolsets.sets.iter().map(|s| s.name.as_str()).collect();
+    Ok(json!({ "toolsets": names, "folder": support.map(|s| s.join(FOLDER).display().to_string()) }))
+}
+
+/// Echo reading problems once.
+pub fn report_errors(app: &mut CadApp) {
+    for e in std::mem::take(&mut app.user_toolsets.errors) {
+        app.session.echo(e);
+    }
+}
+
+/// Submit a tool's input: cancel what is running, then each line as typed.
+pub fn run_tool(app: &mut CadApp, input: &str) {
+    app.cmd.buffer.clear();
+    if app.session.prompting() {
+        app.session.cancel();
+    }
+    for line in input.lines().take(MAX_LINES) {
+        let _ = app.cmdline(line);
+    }
+}
+
+// ---------------------------------------------------------------- icons
+
+/// The icon of `tool` for the current drawing: the first listed block it defines.
+fn icon(app: &mut CadApp, tool: &Tool) -> Option<Arc<DisplayList>> {
+    let st = app.session.state().ok()?;
+    let name = tool.blocks.iter().find(|b| st.doc.block(b).is_some())?;
+    let key = (st.uid, st.revision, name.to_ascii_uppercase());
+    if let Some(v) = app.user_toolsets.icons.get(&key) {
+        return v.clone();
+    }
+    if app.user_toolsets.icons.len() > 4096 {
+        app.user_toolsets.icons.clear();
+    }
+    let built = st.doc.block(name).map(|b| {
+        // What an inserted block shows: no attribute definitions, nothing on layers that are off.
+        let ents: Vec<_> =
+            b.entities.iter().map(|e| e.as_ref()).filter(|e| !matches!(e.kind, EntityKind::AttDef(_)) && st.doc.is_visible(e)).collect();
+        let rough = cadcraft_render::build_entities(&st.doc, ents.iter().copied(), &cadcraft_render::Options::default());
+        let size = rough.bounds.width().max(rough.bounds.height());
+        let opts = cadcraft_render::Options { tolerance: (size / 120.0).max(1e-9), ..Default::default() };
+        Arc::new(if rough.bounds.is_empty() { rough } else { cadcraft_render::build_entities(&st.doc, ents.iter().copied(), &opts) })
+    });
+    let built = built.filter(|l| !l.bounds.is_empty() && !l.prims.is_empty());
+    app.user_toolsets.icons.insert(key, built.clone());
+    built
+}
